datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String            @id @default(cuid())
  email       String?           @unique
  name        String?
  households  HouseholdMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Household {
  id               String            @id @default(cuid())
  name             String?
  availableCash    Int               @default(0) // Available money in VND
  nextIncomeDate   DateTime?         // When is the next income?
  nextIncomeAmount Int?
  safetyBuffer     Int               @default(0) // How much to keep untouched
  
  members          HouseholdMember[]
  obligations      Obligation[]
  protectedSavings ProtectedSaving[]
  transactions     Transaction[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model HouseholdMember {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  role        String    @default("MEMBER") // ADMIN, MEMBER
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model Obligation {
  id          String    @id @default(cuid())
  householdId String
  name        String
  amount      Int
  dueDate     DateTime
  isPaid      Boolean   @default(false)
  type        String?   // e.g., rent, utility
  isRecurring Boolean   @default(false)

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProtectedSaving {
  id          String    @id @default(cuid())
  householdId String
  name        String
  amount      Int
  
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Transaction {
  id          String    @id @default(cuid())
  householdId String
  amount      Int       // positive representing the cost
  note        String?
  date        DateTime  @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
